rules_version = '2';
// Sicherheitsregeln für Firestore (in der Firebase-Konsole unter Firestore → Regeln einfügen)
service cloud.firestore {
  match /databases/{database}/documents {

    // Persönliche Statistik: nur der eigene Nutzer darf lesen und schreiben
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Weltrangliste: alle dürfen lesen, jeder nur seinen eigenen Eintrag schreiben (mit Plausibilitätsprüfung)
    match /leaderboard/{uid} {
      allow read: if true;
      allow delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.name is string && request.resource.data.name.size() <= 24
        && request.resource.data.avg is number && request.resource.data.avg >= 0 && request.resource.data.avg <= 180
        && request.resource.data.rankAvg is number && request.resource.data.rankAvg <= 180
        && request.resource.data.bestCheckout is number && request.resource.data.bestCheckout <= 170
        && request.resource.data.t180 is int && request.resource.data.t180 >= 0
        && request.resource.data.wins is int && request.resource.data.wins >= 0;
    }
  }
}
